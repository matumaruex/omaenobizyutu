# Xiaomi MiMoの従量課金用APIキー。VercelではSecretとして登録。
# 未設定時は選定エラーを表示します。ローカル選定への切り替えはありません。
MIMO_API_KEY=

# 累計・重複防止・上限を永続保存するRedis（どちらもサーバー専用）
# Vercel連携が KV_REST_API_URL / KV_REST_API_TOKEN を設定する場合も対応。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 環境全体での累計送信枠。失敗・中断も含み、日次リセットはしません。
MIMO_TEST_CALL_LIMIT=50
# 家族向けなどの共有用入口では1に設定。共有の選定・料金履歴をサーバーでも非公開にします。
# MUSEUM_GUEST_MODE=1
# 任意。通常は既定の環境別領域を使用。変更すると別の累計になります。
# MIMO_USAGE_NAMESPACE=museum-preview-v1
# 単価・円換算の変更はsrc/config/mimo-pricing.json、またはMIMO_PRICING_JSON（完全なJSON）。
# 初期為替は1米ドル150円の仮定値。実勢レートを自動取得しません。
